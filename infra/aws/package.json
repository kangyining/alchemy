{
  "name": "alchemy-infra",
  "version": "0.1.0",
  "bin": {
    "alchemy-infra": "bin/alchemy-infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:dev": "npx cdk deploy alchemy-infra-dev --profile alchemy-dev",
    "deploy:prod": "npx cdk deploy alchemy-infra-prod --profile alchemy-prod",
    "diff:dev": "npx cdk diff alchemy-infra-dev --profile alchemy-dev",
    "diff:prod": "npx cdk diff alchemy-infra-prod --profile alchemy-prod",
    "synth:dev": "npx cdk synth alchemy-infra-dev --profile alchemy-dev",
    "synth:prod": "npx cdk synth alchemy-infra-prod --profile alchemy-prod"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "aws-cdk": "2.1033.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.215.0",
    "constructs": "^10.0.0"
  }
}
