# Google Cloud Project Settings
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI (recommended for production)
GOOGLE_GENAI_USE_VERTEXAI=True

# OR use API key instead of Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=False
# GOOGLE_API_KEY=your-gemini-api-key

# Document AI Settings
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-layout-parser-processor-id

# Cloud Run Service Settings (optional)
SERVICE_NAME=report-agents
APP_NAME=report_agents
